<?xml version="1.0" encoding="UTF-8"?>
<!--
  One-time setup:
    1. security add-generic-password -s weight-tracker-watcher -a github-pat -w <your-github-pat>
    2. cp com.halfassedapps.weight-tracker-watcher.plist ~/Library/LaunchAgents/
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.halfassedapps.weight-tracker-watcher.plist
    4. launchctl kickstart -k gui/$(id -u)/com.halfassedapps.weight-tracker-watcher
    5. tail -f ~/Library/Logs/weight-tracker-watcher.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.halfassedapps.weight-tracker-watcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec /usr/bin/python3 "/Users/jeffreymiesemer/Library/Mobile Documents/com~apple~CloudDocs/Projects/Weight-Tracker/watcher/weight_export_watcher.py"</string>
  </array>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/jeffreymiesemer/Library/Logs/weight-tracker-watcher.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jeffreymiesemer/Library/Logs/weight-tracker-watcher.log</string>
</dict>
</plist>
